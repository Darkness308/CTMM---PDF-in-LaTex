\ProvidesPackage{style/ctmm-design}[2025/07/01 CTMM Design System]

% Farbschema
\definecolor{ctmmBlue}{HTML}{003087}
\definecolor{ctmmGreen}{HTML}{4CAF50}
\definecolor{ctmmOrange}{HTML}{FF6200}
\definecolor{ctmmRed}{HTML}{D32F2F}
\definecolor{ctmmPurple}{HTML}{7B1FA2}
\definecolor{ctmmGray}{HTML}{757575}
\definecolor{ctmmYellow}{HTML}{FFC107}


% tcolorbox für CTMM-Boxen
\RequirePackage{tcolorbox}
\RequirePackage{etoolbox}

% Box-Stile definieren
% Unterstützt beide Syntaxen: \begin{ctmmBlueBox}{Titel} und \begin{ctmmBlueBox}[title=Titel]
% Arg 1 (O{}): optionale kv-Optionen für tcolorbox
% Arg 2 (G{}): optionaler Titel als Gruppe {Titel}

\NewDocumentEnvironment{ctmmBlueBox}{O{} G{}}{%
  \ifblank{#2}{%
    \begin{tcolorbox}[colback=ctmmBlue!5!white, colframe=ctmmBlue, #1]%
  }{%
    \begin{tcolorbox}[colback=ctmmBlue!5!white, colframe=ctmmBlue, title={#2}, #1]%
  }%
}{%
  \end{tcolorbox}%
}

\NewDocumentEnvironment{ctmmGreenBox}{O{} G{}}{%
  \ifblank{#2}{%
    \begin{tcolorbox}[colback=ctmmGreen!5!white, colframe=ctmmGreen, #1]%
  }{%
    \begin{tcolorbox}[colback=ctmmGreen!5!white, colframe=ctmmGreen, title={#2}, #1]%
  }%
